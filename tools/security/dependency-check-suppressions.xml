<?xml version="1.0" encoding="UTF-8"?>
<!--
  OWASP Dependency-Check suppressions for the Java reactor (optional second opinion next to Trivy/osv-scanner;
  slower and needs an NVD API key). Run:

    cd java && ./mvnw -B org.owasp:dependency-check-maven:12.1.0:aggregate \
      -DnvdApiKey="$NVD_API_KEY" -DfailBuildOnCVSS=9 -Dformats=HTML,SARIF,JSON \
      -DsuppressionFile=../tools/security/dependency-check-suppressions.xml

  Every suppression names the CVE (or CPE false positive), an expiry ("until") and why it does not apply.
  https://jeremylong.github.io/DependencyCheck/general/suppression.html
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
  <!-- CPE false positive: our own platform libraries share names with unrelated products in the NVD. -->
  <suppress until="2027-06-30Z">
    <notes>com.afrotransact:* are first-party modules; any CPE match is a name collision.</notes>
    <packageUrl regex="true">^pkg:maven/com\.afrotransact/.*$</packageUrl>
    <cpe regex="true">.*</cpe>
  </suppress>
</suppressions>
