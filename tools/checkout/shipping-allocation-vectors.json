{
  "description": "Shipping allocation test vectors shared by orders (Java ShippingAllocationTest) and gateway-bff (Go shipping_alloc_test.go). PROPORTIONAL: floor(total*w/sum) per line, spare minor units go to the largest remainder (ties: lowest index); all on the first line when every weight is 0. FIRST_LINE: the whole amount on the first line (rollback). Weights are the lines' net item value (items minus discount). The attribution method for mixed baskets is an OPEN LEGAL DECISION (category-tax-design.md, open decision 5).",
  "cases": [
    {
      "name": "single line takes all",
      "method": "PROPORTIONAL",
      "totalMinor": 599,
      "weightsMinor": [
        1000
      ],
      "expectedMinor": [
        599
      ]
    },
    {
      "name": "two equal lines split evenly",
      "method": "PROPORTIONAL",
      "totalMinor": 600,
      "weightsMinor": [
        1000,
        1000
      ],
      "expectedMinor": [
        300,
        300
      ]
    },
    {
      "name": "odd cent goes to the first of equal remainders",
      "method": "PROPORTIONAL",
      "totalMinor": 599,
      "weightsMinor": [
        1000,
        1000
      ],
      "expectedMinor": [
        300,
        299
      ]
    },
    {
      "name": "exempt-only package: every line carries its share, total preserved",
      "method": "PROPORTIONAL",
      "totalMinor": 499,
      "weightsMinor": [
        2500,
        1500
      ],
      "expectedMinor": [
        312,
        187
      ]
    },
    {
      "name": "mixed package: 3:1 by item value",
      "method": "PROPORTIONAL",
      "totalMinor": 800,
      "weightsMinor": [
        3000,
        1000
      ],
      "expectedMinor": [
        600,
        200
      ]
    },
    {
      "name": "largest remainder wins the spare minor unit",
      "method": "PROPORTIONAL",
      "totalMinor": 100,
      "weightsMinor": [
        1,
        1,
        1
      ],
      "expectedMinor": [
        34,
        33,
        33
      ]
    },
    {
      "name": "zero-value line carries no shipping when others have value",
      "method": "PROPORTIONAL",
      "totalMinor": 500,
      "weightsMinor": [
        0,
        2000,
        3000
      ],
      "expectedMinor": [
        0,
        200,
        300
      ]
    },
    {
      "name": "all lines at zero value: shipping on the first line",
      "method": "PROPORTIONAL",
      "totalMinor": 500,
      "weightsMinor": [
        0,
        0
      ],
      "expectedMinor": [
        500,
        0
      ]
    },
    {
      "name": "no shipping, nothing allocated",
      "method": "PROPORTIONAL",
      "totalMinor": 0,
      "weightsMinor": [
        1000,
        2000
      ],
      "expectedMinor": [
        0,
        0
      ]
    },
    {
      "name": "discounted lines weigh by net value",
      "method": "PROPORTIONAL",
      "totalMinor": 1000,
      "weightsMinor": [
        500,
        1500,
        2000
      ],
      "expectedMinor": [
        125,
        375,
        500
      ]
    },
    {
      "name": "rounding vector with three unequal lines",
      "method": "PROPORTIONAL",
      "totalMinor": 599,
      "weightsMinor": [
        1250,
        900,
        2200
      ],
      "expectedMinor": [
        172,
        124,
        303
      ]
    },
    {
      "name": "large amounts do not overflow",
      "method": "PROPORTIONAL",
      "totalMinor": 999999999,
      "weightsMinor": [
        4000000000,
        1000000000,
        5000000000
      ],
      "expectedMinor": [
        400000000,
        100000000,
        499999999
      ]
    },
    {
      "name": "rollback: first line carries all",
      "method": "FIRST_LINE",
      "totalMinor": 599,
      "weightsMinor": [
        1000,
        2000
      ],
      "expectedMinor": [
        599,
        0
      ]
    },
    {
      "name": "rollback: single line",
      "method": "FIRST_LINE",
      "totalMinor": 599,
      "weightsMinor": [
        1000
      ],
      "expectedMinor": [
        599
      ]
    }
  ]
}