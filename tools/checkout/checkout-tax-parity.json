        "state": "TX",
        "postalCode": "77002",
        "city": "Houston"
      },
      "shippingDiscountMinor": 0,
      "packages": [
        {
          "sellerOrgId": "org_a",
          "feeMinor": 599,
          "membershipWaivedMinor": 0,
          "pickup": false,
          "lines": [
            {
              "lineId": "l1",
              "atin": "ATIN-1",
              "offerId": "of-1",
              "productType": "pantry",
              "quantity": 2,
              "unitPriceMinor": 1000,
              "discountMinor": 0,
              "outcome": "TAXABLE",
              "sellerBehaviour": {}
            }
          ]
        }
      ],
      "rateBps": 825,
      "expected": {
        "requestLines": [
          {
            "lineId": "l1",
            "atin": "ATIN-1",
            "productType": "pantry",
            "quantity": 2,
