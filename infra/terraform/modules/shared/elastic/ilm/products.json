{
  "policy": {
    "_meta": {
      "description": "Catalog/search indices: always hot, rolled over by size so the alias swap stays cheap.",
      "managed_by": "infra/terraform/modules/shared/elastic"
    },
    "phases": {
      "hot": {
        "actions": {
          "rollover": { "max_primary_shard_size": "30gb", "max_age": "30d" },
          "set_priority": { "priority": 100 }
        }
      },
      "delete": {
        "min_age": "60d",
        "actions": { "delete": {} }
      }
    }
  }
}
