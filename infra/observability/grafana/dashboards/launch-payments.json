{
  "uid": "at-launch-payments",
  "title": "AfroTransact / Checkout and payments funnel",
  "description": "Traffic through cart, orders and payments, checkout outcomes, Stripe webhook processing, settlement transfers and Temporal failures. checkout_attempts_total is a contract metric NOT yet emitted by the orders service (panels stay empty until it is).",
  "tags": [
    "afrotransact",
    "launch",
    "payments",
    "business"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {},
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "templating": {
    "list": [
      {
        "name": "env",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(up, env)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "definition": "label_values(up, env)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "hide": 0,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      }
    ]
  },
  "links": [
    {
      "type": "dashboards",
      "tags": [
        "afrotransact"
      ],
      "asDropdown": true,
      "title": "AfroTransact"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Funnel (traffic through the services)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests / s: gateway-bff, cart, orders, payments",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(sum by (service) (rate(http_server_requests_seconds_count{env=~\"$env\", service=~\"gateway-bff|cart|orders|payments\"}[$__rate_interval]))) or (sum by (service) (rate(http_server_requests_total{env=~\"$env\", service=~\"gateway-bff|cart|orders|payments\"}[$__rate_interval])))",
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "5xx ratio: orders, payments",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 1,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "((sum by (service) (rate(http_server_requests_seconds_count{env=~\"$env\", service=~\"orders|payments\", status=~\"5..\"}[$__rate_interval]))) or (sum by (service) (rate(http_server_requests_total{env=~\"$env\", service=~\"orders|payments\", status=~\"5..\"}[$__rate_interval])))) / ((sum by (service) (rate(http_server_requests_seconds_count{env=~\"$env\", service=~\"orders|payments\"}[$__rate_interval]))) or (sum by (service) (rate(http_server_requests_total{env=~\"$env\", service=~\"orders|payments\"}[$__rate_interval]))))",
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.05
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "p95 latency: orders, payments, gateway-bff",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(histogram_quantile(0.95, sum by (service, le) (rate(http_server_requests_seconds_bucket{env=~\"$env\", service=~\"orders|payments|gateway-bff\"}[$__rate_interval])))) or (histogram_quantile(0.95, sum by (service, le) (rate(http_server_request_duration_seconds_bucket{env=~\"$env\", service=~\"orders|payments|gateway-bff\"}[$__rate_interval]))))",
          "legendFormat": "{{service}}",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
