      "targets": [
        {
          "expr": "count(count by (topic) (kafka_topic_partitions{env=~\"$env\", topic=~\"at\\\\..*\"}))",
          "legendFormat": "",
          "instant": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
