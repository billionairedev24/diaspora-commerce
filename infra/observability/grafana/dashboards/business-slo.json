        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 14,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max by (slo) (slo:sli_error:ratio_rate1h{env=~\"$env\"}) / on (slo) group_left max by (slo) (slo:error_budget:ratio)",
