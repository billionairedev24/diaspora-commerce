    {
      "id": 8,
      "type": "timeseries",
      "title": "core resident memory vs the 2.0 GiB cap (ADR 0011 S1)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "max(process_resident_memory_bytes{job=\"afrotransact-core\", env=~\"$env\"})",
          "legendFormat": "RSS",
          "range": true,
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "vector(2147483648)",
          "legendFormat": "cap 2 GiB (container limit)",
          "range": true,
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "The container limit is the cap: the kernel OOM-kills above it. Alert: CoreMemoryNearCap."
    },
