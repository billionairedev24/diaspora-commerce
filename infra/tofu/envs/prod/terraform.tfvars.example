# Copy to terraform.tfvars and commit it: non-secret values only (credentials come from environment variables).
# PRODUCTION = OVHcloud Managed Kubernetes (OVH US account) + Layerbase PostgreSQL. Other clouds stay supported by the modules;
# switch `cloud` and the identity lines below (docs/engineering/cloud-cost.md has the alternatives, none of them is the launch path).

# ---- the one switch -------------------------------------------------------------------------------
cloud            = "ovh"
region           = "US-EAST-VA-1" # OVH US East (Vint Hill, Virginia). MUST be next to Layerbase: virginia = ovh US-EAST-VA-1 | aws us-east-1 | gcp us-east4 | azure eastus
layerbase_region = "virginia"     # virginia | oregon (Layerbase Dedicated 16 GB is Virginia only)

# ---- identity of the OVH account/project (OVH US entity is a SEPARATE account from OVH EU/CA) -------------------------
ovh_service_name = "<public cloud project id>" # Public Cloud project in the OVH US account (credentials: OVH_APPLICATION_KEY / _SECRET / OVH_CONSUMER_KEY)
ovh_endpoint     = "ovh-us"                    # US-* regions REQUIRE ovh-us (checked at plan time)
# gcp_project_id        = "afrotransact-prod"
# azure_subscription_id = "00000000-0000-0000-0000-000000000000"
# azure_tenant_id       = "00000000-0000-0000-0000-000000000000"

# ---- network & access --------------------------------------------------------------------------------
cidr_block = "10.40.0.0/16"
web_domain = "afrotransact.com"
# REQUIRED on OVH production: the Kubernetes API of the free plan is public, so it is restricted to these CIDRs (ovh_cloud_project_kube_iprestrictions).
# Your office/VPN egress, /32 for a single admin. Argo CD runs inside the cluster and does not need an entry; GitHub-hosted runners have no fixed IPs and are NOT allowed.
admin_cidrs = [] # e.g. ["203.0.113.7/32"]  <- tofu plan fails while this is empty

# ---- OVH extras that the launch profile leaves OFF -----------------------------------------------------------
ovh_okms   = false # OVH Secret Manager: secrets are SOPS/age files (infra/ops/secrets). OKMS in the US is unverified and the module refuses a US region.
ovh_harbor = false # OVH Managed Private Registry: images come from GHCR with a read-only pull secret.

# ---- tags --------------------------------------------------------------------------------------------
owner       = "platform"
cost_center = "engineering"

# ---- GitHub OIDC: OVH has none (no module resources are created); keep false ---------------------------------
create_github_oidc_provider = false

# ---- SaaS: all off. Search is Meilisearch in the cluster; Kafka and Temporal run in the cluster (infra/k8s/platform/lean). ----
enable_elastic   = false
enable_confluent = false
enable_temporal  = false

# ---- cost: the monthly budget amount is in sizing.tf ---------------------------------------------------------
budget_notification_emails = [] # e.g. ["platform-alerts@afrotransact.com", "finance@afrotransact.com"]
budget_shared_account      = false
# gcp_billing_account      = "01ABCD-23EF45-6789AB"   # gcp only
