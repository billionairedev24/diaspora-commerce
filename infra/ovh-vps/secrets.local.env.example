# Copy to secrets.local.env (never commit it). Third-party keys; everything else is generated by secrets.sh.
# Leave a key empty to start that service without the integration (some services refuse to start without theirs: noted).

STRIPE_SECRET_KEY=sk_test_xxx            # payments, seller. Test-mode key.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx       # gateway-bff REFUSES TO START without it
# The three webhook secrets (whsec_..., one per Stripe endpoint, Snapshot payload): docs/runbooks/stripe-webhooks.md
STRIPE_WEBHOOK_SECRET=whsec_xxx          # payments, REQUIRED: https://api.$DOMAIN/payments/v1/webhooks/stripe (Your account)
STRIPE_CONNECT_WEBHOOK_SECRET=           # seller, REQUIRED for sellers: https://api.$DOMAIN/seller/v1/webhooks/stripe-connect (Connected accounts)
STRIPE_BILLING_WEBHOOK_SECRET=           # seller, optional (bank-debit plan fees): https://api.$DOMAIN/seller/v1/webhooks/stripe-billing (Your account)
RESEND_API_KEY=                          # notifications: email (OVHcloud blocks outbound SMTP 25/465/587; Resend uses HTTPS)
OPENROUTER_API_KEY=                      # ai-gateway (Lola)
GOOGLE_PLACES_API_KEY=                   # geo
GOOGLE_MAPS_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
UPLOADTHING_API_KEY=                     # media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
USPS_CLIENT_ID=                          # carrier-gateway sandbox keys (docs/runbooks/carrier-sandboxes.md)
USPS_CLIENT_SECRET=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=

# --- production only (PROFILE=prod): the OVH Object Storage keys of the media service's private bucket (afrotransact-prod-kyc-evidence)
OVH_S3_ACCESS_KEY_ID=
OVH_S3_SECRET_ACCESS_KEY=
# --- production only (PROFILE=prod): edge, telemetry and backups (platform secrets)
CLOUDFLARED_TUNNEL_TOKEN=                # `cloudflared tunnel token <tunnel id>` (infra/cloudflare, origin_mode = tunnel)
GRAFANA_OTLP_ENDPOINT=                   # https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=
BACKUP_AGE_RECIPIENT=                    # age1... PUBLIC key; the private key stays offline (docs/runbooks/restore-drill.md)
BACKUP_REMOTE=backup:afrotransact-pg-backups   # rclone path: remote "backup" + bucket, at a vendor other than Layerbase
BACKUP_S3_PROVIDER=Cloudflare            # rclone s3 provider: Cloudflare | Other | ...
BACKUP_S3_ENDPOINT=                      # e.g. https://<account>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_HEALTHCHECK_URL=                  # optional dead-man's-switch ping URL (healthchecks.io style)
