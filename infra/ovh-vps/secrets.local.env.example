# Copy to secrets.local.env (never commit it). Third-party keys; everything else is generated by secrets.sh.
# Leave a key empty to start that service without the integration (some services refuse to start without theirs: noted).

STRIPE_SECRET_KEY=sk_test_xxx            # payments, seller. Test-mode key.
STRIPE_PUBLISHABLE_KEY=pk_test_xxx       # gateway-bff REFUSES TO START without it
STRIPE_WEBHOOK_SECRET=whsec_xxx          # payments: endpoint https://api.$DOMAIN/payments/v1/webhooks/stripe
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=
RESEND_API_KEY=                          # notifications: email (OVHcloud blocks outbound SMTP 25/465/587; Resend uses HTTPS)
OPENROUTER_API_KEY=                      # ai-gateway (Lola)
GOOGLE_PLACES_API_KEY=                   # geo
GOOGLE_MAPS_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=
UPLOADTHING_API_KEY=                     # media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
USPS_CLIENT_ID=                          # carrier-gateway sandbox keys (docs/runbooks/carrier-sandboxes.md)
USPS_CLIENT_SECRET=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=
FEDEX_CLIENT_ID=
FEDEX_CLIENT_SECRET=
