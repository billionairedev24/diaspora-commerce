# Copy to secrets.local.env (never commit it). Third-party keys; everything else is generated by secrets.sh (every internal secret,
# LINK_SIGNING_KEY included: never type one). Only the keys of the 21 LAUNCH-SET services are here; keys of services that are not
# launched (carrier-gateway, retail, promise, delivery-runs, authz-sync) and of the dev test box are at the bottom, commented out.
# Leave a key empty to start that service without the integration (some services refuse to start without theirs: noted).
# The 8-day trial uses secrets.trial.env.example (Stripe TEST keys, GRAFANA_ENV=trial, the trial bucket) instead of this file.

# Pull secret "ghcr" (read-only token with only read:packages) and identity's first admin (a real address and a password of 16+
# characters: secrets.sh refuses the example values for PROFILE=prod). Same place as docs/runbooks/ovh-production.md section 6.
GHCR_USER=
GHCR_TOKEN=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

STRIPE_SECRET_KEY=                       # payments, seller. sk_live_... in production, sk_test_... in the trial
STRIPE_PUBLISHABLE_KEY=                  # gateway-bff REFUSES TO START without it (pk_live_ in prod, pk_test_ in the trial)
# The three webhook secrets (whsec_..., one per Stripe endpoint, Snapshot payload): docs/runbooks/stripe-webhooks.md
STRIPE_WEBHOOK_SECRET=                  # payments, REQUIRED: https://<api host>/payments/v1/webhooks/stripe (Your account)
STRIPE_CONNECT_WEBHOOK_SECRET=           # seller, REQUIRED for sellers: https://<api host>/seller/v1/webhooks/stripe-connect (Connected accounts)
STRIPE_BILLING_WEBHOOK_SECRET=           # seller, optional (bank-debit plan fees): https://<api host>/seller/v1/webhooks/stripe-billing (Your account)
RESEND_WEBHOOK_SECRET=                   # notifications, REQUIRED in prod (whsec_..., docs/runbooks/resend-email.md): bounces and complaints
RESEND_API_KEY=                          # notifications: email (OVHcloud blocks outbound SMTP 25/465/587; Resend uses HTTPS)
OPENROUTER_API_KEY=                      # ai-gateway (Lola)
GOOGLE_PLACES_API_KEY=                   # geo
GOOGLE_MAPS_API_KEY=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# --- Cloudflare R2, two buckets, one token each (docs/runbooks/r2-buckets.md): media refuses to start in prod without all five
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=                         # PUBLIC bucket token (afrotransact-<env>-media)
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_ACCESS_KEY_ID=                # PRIVATE bucket token (afrotransact-<env>-kyc-evidence)
R2_PRIVATE_SECRET_ACCESS_KEY=
# --- production only (PROFILE=prod): edge, telemetry and backups (platform secrets)
CLOUDFLARED_TUNNEL_TOKEN=                # `cloudflared tunnel token <tunnel id>` (infra/cloudflare, origin_mode = tunnel)
GRAFANA_OTLP_ENDPOINT=                   # https://otlp-gateway-<region>.grafana.net/otlp
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=
# Grafana Alloy (metrics + logs): docs/runbooks/observability-grafana-cloud.md. One stack (https://afrotransact.grafana.net/),
# one access-policy token PER ENV (afrotransact-alloy-trial, afrotransact-alloy-prod), scopes metrics:write + logs:write only.
GRAFANA_ENV=prod                         # trial | prod: the `env` label on every series and log line (alerts route only for prod)
GRAFANA_PROM_URL=                        # https://prometheus-prod-NN-<region>.grafana.net/api/prom/push  (Connections > Hosted Prometheus metrics)
GRAFANA_PROM_USER=                       # numeric "Username / Instance ID" of Hosted Prometheus metrics
GRAFANA_LOKI_URL=                        # https://logs-prod-NNN.grafana.net/loki/api/v1/push            (Connections > Hosted logs)
GRAFANA_LOKI_USER=                       # numeric "Username / Instance ID" of Hosted logs
GRAFANA_ALLOY_TOKEN=                     # the access-policy token (glc_...), never pasted into chat or committed in clear
BACKUP_AGE_RECIPIENT=                    # age1... PUBLIC key; the private key stays offline (docs/runbooks/restore-drill.md)
# Backups go to Backblaze B2 (S3 API, rclone), NEVER to Cloudflare R2: one private bucket per environment, one application key per
# bucket (Read and Write, restricted to that bucket). Setup, retention, lifecycle rule, restore, rotation: docs/runbooks/backups-backblaze.md
BACKUP_B2_KEY_ID=                        # application key id (keyID)
BACKUP_B2_APPLICATION_KEY=               # the application key itself, shown once
BACKUP_B2_BUCKET=afrotransact-prod-backups
BACKUP_B2_ENDPOINT=                      # from the B2 console (bucket > Endpoint): s3.<region>.backblazeb2.com, no region is assumed
BACKUP_RETENTION_DAYS=14                 # days of backups kept (3..365); the owner may set 7
BACKUP_RETENTION_MODE=sweep              # sweep (the job deletes) | lifecycle (the bucket rule deletes) | off
BACKUP_PUSHGATEWAY_URL=                  # optional: size metrics are also pushed there (infra/observability/rules/backup.yaml)
BACKUP_HEALTHCHECK_URL=                  # optional dead-man's-switch ping URL (healthchecks.io style)

# --- NOT LAUNCHED / TEST BOX ONLY (ovh-vps.yml, profile dev). Ignored by PROFILE=prod and by the trial; keep commented out.
# UPLOADTHING_API_KEY=                   # media on the test box (prod media is R2 only)
# USPS_CLIENT_ID=                        # carrier-gateway sandbox keys (docs/runbooks/carrier-sandboxes.md): carrier-gateway is not launched
# USPS_CLIENT_SECRET=
# UPS_CLIENT_ID=
# UPS_CLIENT_SECRET=
# FEDEX_CLIENT_ID=
# FEDEX_CLIENT_SECRET=
