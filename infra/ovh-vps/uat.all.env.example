# UAT: the ONE place for every value you handle. Copy it OUTSIDE the repository and keep it private:
#     tools/release/uat-env.sh init          creates ~/.afrotransact/uat.all.env (mode 600) from this file
#     tools/release/uat-env.sh check         names the blanks and bad formats; it never prints a value
#     tools/release/uat-env.sh github        sets the GitHub variables and secrets from it (uat-github-setup.sh reads it)
#     tools/release/uat-env.sh split         writes infra/ovh-vps/config.env and secrets.local.env for secrets.sh (quoted correctly)
#     eval "$(tools/release/uat-env.sh tofu-env)"    exports the tofu / Cloudflare infrastructure credentials into THIS shell only
#
# Rules for this file:
#   * NAME=value, one per line, nothing else on the line. NO trailing "# comment" after a value. A value with spaces, # or $ goes in double quotes.
#   * The tools READ this file as data. They never `source` it, never print a value, never send a value anywhere but its destination.
#   * Master copy: your password manager (one item "AfroTransact UAT"). This file is the working copy. Do not put it in git, chat, a ticket, or a synced folder.
#   * Values for UAT only. PROD has its own file with its own, different tokens (never reuse a UAT token in prod).
#   * Fill it in the order of the runbook (docs/runbooks/release-1-go-live.md). `check github`, `check tofu`, `check cluster` check one group at a time.
#
# Every name is in exactly one group. Group = where the value goes:  [github]  [tofu]  [cluster]

# ===================================================================================================================================
# [github]  GitHub Actions secrets for the UAT pipeline (set by `uat-env.sh github`). Explanations: `uat-github-setup.sh list`.
# ===================================================================================================================================
# GitHub App that commits the image pin. github.com > Settings > Developer settings > GitHub Apps > New (Contents RW, Pull requests RW).
# The App ID is on its About page.
GITOPS_APP_ID=
# Path to the .pem you generated on the App's page (a PATH, not the key). Keep the .pem in your password manager too.
GITOPS_APP_PRIVATE_KEY_FILE=
# Cloudflare account id: dash.cloudflare.com > Workers & Pages > Account ID (32 hex). Also used by tofu and (when R2_ACCOUNT_ID is blank) by R2.
CLOUDFLARE_ACCOUNT_ID=
# DEPLOY token for GitHub (least privilege): Account > Workers Scripts Edit, Cloudflare Pages Edit; Zone > Workers Routes Edit, Zone Read; only your
# account and the afrotransact.com zone. NOT the same token as CLOUDFLARE_INFRA_TOKEN below (`check` refuses equal values).
CLOUDFLARE_DEPLOY_TOKEN=

# ===================================================================================================================================
# [tofu]  Infrastructure credentials. They stay on YOUR machine (tofu), never go to GitHub or the cluster.
# ===================================================================================================================================
# OVH US API credentials: https://api.us.ovhcloud.com/createToken/  rights: GET/POST/PUT/DELETE /cloud/project/<id>/*  and GET /me
OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=
# The OVH Public Cloud project id (OVH panel > Public Cloud > the project's id), one disposable project for UAT.
OVH_SERVICE_NAME=
# Your public IP as a /32 for the cluster's admin access (never 0.0.0.0/0): `curl -s https://api.ipify.org` then append /32
OVH_ADMIN_CIDR=
# Infrastructure token for tofu (tunnel, DNS, R2 buckets, Workers routes, Pages domain, zone settings). Stronger than the deploy token:
# Account: Workers Scripts Edit, Workers R2 Storage Edit, Cloudflare Tunnel Edit, Cloudflare Pages Edit, Account Settings Read, Turnstile Edit;
# Zone: Zone Read, DNS Edit, Workers Routes Edit, SSL and Certificates Edit. (Dashboard wording may differ slightly.)
CLOUDFLARE_INFRA_TOKEN=

# ===================================================================================================================================
# [cluster]  Cluster configuration and secrets. `uat-env.sh split` writes them to infra/ovh-vps/config.env and secrets.local.env; secrets.sh renders,
# sops encrypts, apply.sh applies (runbook section 6). Generated keys (signing keys, IDENTITY_DATA_KEY, client secrets) are NOT here: secrets.sh makes them.
# ===================================================================================================================================
# --- config (not secrets, except the database admin password and the Valkey URL)
DOMAIN=afrotransact.com
IMAGE_REGISTRY=ghcr.io/billionairedev24/diaspora-commerce
# any 40-hex sha: secrets.sh only checks the shape; the real pin is values-uat.yaml after promote
IMAGE_TAG=0000000000000000000000000000000000000000
DB_MODE=external
DB_LAYOUT=schema
# Layerbase Postgres, its OWN server for UAT (never shared with prod); admin has CREATEROLE/CREATEDB
EXTERNAL_PG_HOST=
EXTERNAL_PG_ADMIN_USER=
EXTERNAL_PG_ADMIN_PASSWORD=
# require encrypts but does not verify the server. Ask Layerbase for the CA, save it, set verify-full here and the file path below.
EXTERNAL_PG_SSLMODE=require
# path of the provider's CA bundle (PEM) on this machine; REQUIRED when the sslmode is verify-ca or verify-full
EXTERNAL_PG_CA_FILE=
# Layerbase Valkey: rediss://<user>:<password>@<host>:<port>. Policy needed: maxmemory-policy volatile-lru (or allkeys-lru), never noeviction
EXTERNAL_REDIS_URL=

# --- pull secret and first admin
# Read-only GitHub token with ONLY read:packages (github.com > Settings > Developer settings > Personal access tokens), and your GitHub user name
GHCR_USER=
GHCR_TOKEN=
# first staff admin: a real address you read, a password of 16+ characters (generate one in your password manager), a phone (optional)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_PHONE=

# --- Stripe TEST mode (uat accepts only sk_test_/rk_test_ and pk_test_). Dashboard > Developers > API keys.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
# One whsec_ per webhook endpoint (Snapshot payload), three different values. ORDER PROBLEM and its fix: apply.sh refuses empty webhook secrets, but the
# endpoints are normally created after the first deploy. Create the endpoints FIRST (Stripe lets you register a URL that does not answer yet; UNVERIFIED),
# at https://api-uat.afrotransact.com/payments/v1/webhooks/stripe, .../seller/v1/webhooks/stripe-connect, .../seller/v1/webhooks/stripe-billing (see
# docs/runbooks/stripe-webhooks.md for events). If Stripe refuses an unreachable URL, put a RANDOM unguessable value (for example
# whsec_ followed by `openssl rand -hex 32`) here for the first apply only, then replace it with the real one and restart core. NEVER a guessable
# placeholder: anyone who knew it could forge payment events.
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_WEBHOOK_SECRET=
STRIPE_BILLING_WEBHOOK_SECRET=

# --- Resend (email): resend.com > API Keys, and Webhooks (whsec_). Same order problem and fix as Stripe for the webhook secret.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- AI (Lola): openrouter.ai > Keys. Set the spend limit in the OpenRouter dashboard too (second guard behind the USD 2/day in-code cap).
OPENROUTER_API_KEY=

# --- Google Maps Platform: ONE key is enough. Enable Places API (New), Geocoding API and Routes API on its project. GOOGLE_PLACES_API_KEY can stay blank
#     (the geo service falls back to GOOGLE_MAPS_API_KEY). Google is the only address provider.
GOOGLE_PLACES_API_KEY=
GOOGLE_MAPS_API_KEY=

# --- Cloudflare R2: two buckets (afrotransact-uat-media public, afrotransact-uat-kyc-evidence private), one token each (docs/runbooks/r2-buckets.md)
# R2_ACCOUNT_ID blank = the CLOUDFLARE_ACCOUNT_ID above
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PRIVATE_ACCESS_KEY_ID=
R2_PRIVATE_SECRET_ACCESS_KEY=

# --- edge: `cloudflared tunnel token <tunnel id>` after the Cloudflare tofu run created the tunnel
CLOUDFLARED_TUNNEL_TOKEN=

# --- Grafana Cloud (one stack, one access-policy token PER env, scopes metrics:write and logs:write only; docs/runbooks/observability-grafana-cloud.md)
GRAFANA_ENV=uat
GRAFANA_PROM_URL=
GRAFANA_PROM_USER=
GRAFANA_LOKI_URL=
GRAFANA_LOKI_USER=
GRAFANA_ALLOY_TOKEN=
# optional: OTLP gateway (traces) of the same stack
GRAFANA_OTLP_ENDPOINT=
GRAFANA_INSTANCE_ID=
GRAFANA_API_TOKEN=

# --- backups: age PUBLIC key (the private key stays offline) and a Backblaze B2 bucket + application key restricted to that bucket (docs/runbooks/backups-backblaze.md)
BACKUP_AGE_RECIPIENT=
BACKUP_B2_KEY_ID=
BACKUP_B2_APPLICATION_KEY=
BACKUP_B2_BUCKET=afrotransact-uat-backups
# from the B2 console (bucket > Endpoint): s3.<region>.backblazeb2.com
BACKUP_B2_ENDPOINT=
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_MODE=sweep
# optional
BACKUP_PUSHGATEWAY_URL=
BACKUP_HEALTHCHECK_URL=
