# UAT (release-1 go-live dry run of prod): copy to infra/ovh-vps/config.env (never commit it). Read by secrets.sh to RENDER the Secrets on your machine
# (PROFILE=uat, docs/runbooks/release-1-go-live.md); nothing here is applied to a server. UAT's hosts are NOT set here:
# they come from infra/cloudflare/hosts.json (env uat: uat.<zone>, seller-uat.<zone>, admin-uat.<zone>, api-uat.<zone>,
# auth-uat.<zone>, media-uat.<zone>), through infra/argocd/envs/uat/platform-values.yaml.
DOMAIN=afrotransact.com
IMAGE_REGISTRY=ghcr.io/billionairedev24/diaspora-commerce
IMAGE_TAG=0000000000000000000000000000000000000000   # any 40-hex sha: secrets.sh only validates the shape; the pins are values-uat.yaml
DB_MODE=external                                      # Layerbase: its OWN instance for UAT (4 databases: core, go, temporal, temporal_visibility; never shared with prod)
DB_LAYOUT=schema                                      # release-1: one schema and role per module
EXTERNAL_PG_HOST=
EXTERNAL_PG_ADMIN_USER=
EXTERNAL_PG_ADMIN_PASSWORD=
EXTERNAL_PG_SSLMODE=require
# Managed Valkey on Layerbase (a secret VALUE, rediss://<user>:<password>@<host>:<port>; becomes REDIS_URL of cart, gateway-bff, mcp-server). Policy needed: maxmemory-policy volatile-lru (or allkeys-lru), no eviction of nothing.
EXTERNAL_REDIS_URL=
