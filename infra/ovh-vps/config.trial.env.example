# THE 8-DAY TRIAL: copy to infra/ovh-vps/config.env (never commit it). Read by secrets.sh to RENDER the Secrets on your machine
# (PROFILE=prod, docs/runbooks/ovh-production.md "Trial"); nothing here is applied to a server. The trial's hosts are NOT set here:
# they come from infra/cloudflare/hosts.json (env trial: test.<zone>, seller-test.<zone>, admin-test.<zone>, api-test.<zone>,
# auth-test.<zone>, media-test.<zone>), through infra/argocd/envs/trial/platform-values.yaml.
DOMAIN=afrotransact.com
IMAGE_REGISTRY=ghcr.io/billionairedev24/diaspora-commerce
IMAGE_TAG=0000000000000000000000000000000000000000   # any 40-hex sha: secrets.sh only validates the shape; the pins are values-trial.yaml
DB_MODE=external                                      # Layerbase: the plan must allow 19 databases
EXTERNAL_PG_HOST=
EXTERNAL_PG_ADMIN_USER=
EXTERNAL_PG_ADMIN_PASSWORD=
EXTERNAL_PG_SSLMODE=require
