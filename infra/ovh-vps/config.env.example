# PROD (release-1): copy to infra/ovh-vps/config.env (never commit it). Read by secrets.sh to RENDER the Secrets on your machine
# (PROFILE=prod, docs/runbooks/release-1-go-live.md section 6); nothing here is applied to a server. UAT starts from
# config.uat.env.example instead. Prod's hosts are NOT set here: they come from infra/cloudflare/hosts.json (env prod:
# afrotransact.com, seller., admin., api., auth., media.), through infra/argocd/envs/prod/platform-values.yaml.
DOMAIN=afrotransact.com
IMAGE_REGISTRY=ghcr.io/billionairedev24/diaspora-commerce
IMAGE_TAG=0000000000000000000000000000000000000000   # any 40-hex sha: secrets.sh only validates the shape; the pins are values-prod.yaml
# GHCR_USER / GHCR_TOKEN (packages are private: a token with only read:packages) live in secrets.local.env.

DB_MODE=external                                      # Layerbase: prod's OWN server (4 databases: core, go, temporal, temporal_visibility; never shared with uat)
DB_LAYOUT=schema                                      # release-1: one schema and role per module
EXTERNAL_PG_HOST=
EXTERNAL_PG_ADMIN_USER=
EXTERNAL_PG_ADMIN_PASSWORD=
EXTERNAL_PG_SSLMODE=require
# F11: sslmode=verify-full checks the server certificate and host name (require only encrypts). Needs the provider's CA bundle:
# EXTERNAL_PG_CA_FILE = a PEM file on THIS machine (becomes the Secret pg-ca), EXTERNAL_PG_SSLROOTCERT = where the pods see it
# (default /etc/pg-ca/ca.crt, set by the chart value postgresCA.enabled). docs/runbooks/postgres-tls.md. Prod default stays require
# (with a warning) until the CA is known; EXTERNAL_PG_REQUIRE_VERIFY=true makes require an error. Prod go-live wants verify-full.
#EXTERNAL_PG_CA_FILE=
#EXTERNAL_PG_SSLROOTCERT=/etc/pg-ca/ca.crt
#EXTERNAL_PG_REQUIRE_VERIFY=false

# Managed Valkey on Layerbase (a secret VALUE, rediss://<user>:<password>@<host>:<port>; becomes REDIS_URL of cart, gateway-bff, mcp-server).
# Policy needed: maxmemory-policy volatile-lru (or allkeys-lru), never noeviction.
EXTERNAL_REDIS_URL=

# ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_PHONE (identity's first admin, BOOTSTRAP_ADMIN_*) live in secrets.local.env.
