# PROD: copy to infra/ovh-vps/config.env (never commit it). Read by secrets.sh to RENDER the Secrets on your machine
# (PROFILE=prod, docs/runbooks/ovh-production.md section 6, infra/ops/secrets/README.md); nothing here is applied to a server.
# Prod's hosts come from infra/cloudflare/hosts.json through infra/argocd/envs/prod/platform-values.yaml.
DOMAIN=afrotransact.com
IMAGE_REGISTRY=ghcr.io/billionairedev24/diaspora-commerce
IMAGE_TAG=0000000000000000000000000000000000000000   # any 40-hex sha: secrets.sh only validates the shape; the pins are values-prod.yaml
# GHCR_USER / GHCR_TOKEN (packages are private: a token with only read:packages) live in secrets.local.env.

DB_MODE=external                                      # a managed server (Layerbase). Set the four lines below.
EXTERNAL_PG_HOST=
EXTERNAL_PG_ADMIN_USER=
EXTERNAL_PG_ADMIN_PASSWORD=
EXTERNAL_PG_SSLMODE=require
# F11: sslmode=verify-full checks the server certificate and host name (require only encrypts). Needs the provider's CA bundle:
# EXTERNAL_PG_CA_FILE = a PEM file on THIS machine (becomes the Secret pg-ca), EXTERNAL_PG_SSLROOTCERT = where the pods see it
# (default /etc/pg-ca/ca.crt, set by the chart value postgresCA.enabled). docs/runbooks/postgres-tls.md. Prod default stays require
# (with a warning) until the CA is known; EXTERNAL_PG_REQUIRE_VERIFY=true makes require an error.
#EXTERNAL_PG_CA_FILE=
#EXTERNAL_PG_SSLROOTCERT=/etc/pg-ca/ca.crt
#EXTERNAL_PG_REQUIRE_VERIFY=false

# ADMIN_EMAIL / ADMIN_PASSWORD / ADMIN_PHONE (identity's first admin, BOOTSTRAP_ADMIN_*) live in secrets.local.env.
