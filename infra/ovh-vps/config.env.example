# Copy to config.env (never commit it). Read by deploy.sh and secrets.sh on the server.

# Public base domain of this test environment. Point these A records at the server's IPv4 (DNS only, not proxied by
# Cloudflare, so Let's Encrypt can reach port 80):  api.$DOMAIN  auth.$DOMAIN  mcp.$DOMAIN
DOMAIN=test.example.com
ACME_EMAIL=you@example.com
# Where the customer storefront lives: www = https://www.$DOMAIN (the apex redirects to it) | apex = https://$DOMAIN.
# Must match the "storefront-host" the ovh-web workflow deployed the Workers with: identity's redirect URIs, CORS and the
# links in emails all derive from it (global.storefrontHost). Changing it needs a redeploy of the services.
STOREFRONT_HOST=www
# Free certificate layout (flat web hosts): FULL hostnames of the Seller Center and the staff console, empty = seller.$DOMAIN and
# admin.$DOMAIN. Cloudflare's free certificate covers the zone apex and one label under it, so for DOMAIN=test.example.com use
# STOREFRONT_HOST=apex, SELLER_HOST=seller-test.example.com, ADMIN_HOST=admin-test.example.com. Same values as the ovh-web workflow.
SELLER_HOST=
ADMIN_HOST=
# Public media base the services put in image URLs and the web apps allow in their CSP; empty = https://media.$DOMAIN.
MEDIA_PUBLIC_URL=

# Images built by CI (java-*.yml / go-*.yml publish ghcr.io/<repo>/<service>:<full git sha> on every push to main).
IMAGE_REGISTRY=ghcr.io/billionairedev24/diaspora-commerce
IMAGE_TAG=0000000000000000000000000000000000000000
# Only if the packages are private: a GitHub token with read:packages.
GHCR_USER=
GHCR_TOKEN=

# Where PostgreSQL lives.
#   cluster   a Postgres pod on this server's disk. Disposable test data ONLY: if the server goes, the data goes.
#   external  a managed server (Layerbase, OVHcloud Managed PostgreSQL ...). Set the four lines below.
DB_MODE=cluster
EXTERNAL_PG_HOST=
EXTERNAL_PG_ADMIN_USER=
EXTERNAL_PG_ADMIN_PASSWORD=
EXTERNAL_PG_SSLMODE=require

# Valkey/Redis and Meilisearch always run in the cluster here (cache and a rebuildable index).

# Value of identity's first admin (BOOTSTRAP_ADMIN_*), so you can sign in to the staff console.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-12
ADMIN_PHONE=+15555550100
