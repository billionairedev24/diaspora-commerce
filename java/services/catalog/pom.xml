<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.afrotransact</groupId>
        <artifactId>platform-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../platform-parent/pom.xml</relativePath>
    </parent>

    <artifactId>catalog-service</artifactId>
    <name>AfroTransact :: catalog-service</name>
    <description>Products (ATIN/GTIN), variants, category tree, product-type schemas and category requests.</description>

    <properties>
        <pdfbox.version>3.0.8</pdfbox.version>
        <zxing.version>3.5.4</zxing.version>
        <wiremock.version>3.13.2</wiremock.version>
        <poi.version>6.0.0</poi.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- poi 5.4.1 and its commons-compress disagree on commons-io (dependency convergence). -->
            <dependency>
                <groupId>commons-io</groupId>
                <artifactId>commons-io</artifactId>
                <version>2.22.0</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-events</artifactId>
        </dependency>
        <!-- Release 1 (ADR 0011): the in-process caller principal and the published API of the module this one calls. -->
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>module-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>seller-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>offers-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>tax-returns-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>catalog-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-restclient</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <!-- S032: PDF labels and label sheets (barcodes are encoded by catalog itself). -->
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>
        <!-- S308 bulk upload: .xlsx templates, streaming .xlsx reading and error reports (docs/adr/0003). -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi-ooxml</artifactId>
            <version>${poi.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Tests decode the generated barcodes to prove they scan. -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>core</artifactId>
            <version>${zxing.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- Release 1 (ADR 0011): a copy of the service's config and migrations under modules/catalog/, so that two modules in one
                 JVM do not share one application.yml or one db/migration. The plain jar carries only these copies. -->
            <resource>
                <directory>src/main/resources</directory>
                <targetPath>modules/catalog</targetPath>
                <includes>
                    <include>application*.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources/db/migration</directory>
                <targetPath>modules/catalog/db/migration</targetPath>
            </resource>
            <!-- The category tax dataset is the single source of the tree and the tax questions (tools/taxonomy). -->
            <resource>
                <directory>${project.basedir}/../../../tools/taxonomy</directory>
                <targetPath>taxonomy</targetPath>
                <includes>
                    <include>category_tax_map.json</include>
                </includes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <!-- Golden decision cases every implementation of the tax rules must reproduce (tools/taxonomy). -->
            <testResource>
                <directory>${project.basedir}/../../../tools/taxonomy</directory>
                <targetPath>taxonomy</targetPath>
                <includes>
                    <include>decision_cases.jsonl</include>
                    <include>scenarios.json</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <!-- Release 1 (ADR 0011): the classes without the process-wide files (application*.yml, logback, db/migration at the root),
                 for afrotransact-core. The executable jar and the image are unchanged. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>plain-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>plain</classifier>
                            <excludes>
                                <exclude>application*.yml</exclude>
                                <exclude>logback-spring.xml</exclude>
                                <exclude>db/migration/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
