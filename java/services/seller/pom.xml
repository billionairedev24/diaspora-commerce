<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.afrotransact</groupId>
        <artifactId>platform-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../../platform-parent/pom.xml</relativePath>
    </parent>

    <artifactId>seller-service</artifactId>
    <name>AfroTransact :: seller-service</name>
    <description>Seller and provider organisations, onboarding applications, two-step staff review, Stripe Connect accounts and compliance sync, plans and billing (rrule-scheduled, Stripe Payments for collection).</description>

    <properties>
        <wiremock.version>3.13.2</wiremock.version>
        <libphonenumber.version>9.0.42</libphonenumber.version>
        <ical4j.version>4.4.0</ical4j.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-web</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-security</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-events</artifactId>
        </dependency>
        <!-- Release 1 (ADR 0011): the in-process caller principal. -->
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>module-contract</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>payments-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>inventory-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>ai-gateway-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>content-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>identity-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>catalog-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>seller-api</artifactId>
        </dependency>
        <dependency>
            <groupId>com.stripe</groupId>
            <artifactId>stripe-java</artifactId>
        </dependency>
        <dependency>
            <!-- stripe-java declares Gson at runtime scope; compile scope silences annotation warnings. -->
            <groupId>com.google.code.gson</groupId>
            <artifactId>gson</artifactId>
        </dependency>
        <dependency>
            <groupId>com.googlecode.libphonenumber</groupId>
            <artifactId>libphonenumber</artifactId>
            <version>${libphonenumber.version}</version>
        </dependency>
        <!-- RFC 5545 rrule-based billing period scheduling (replaces Stripe Billing subscription lifecycle) -->
        <dependency>
            <groupId>org.mnode.ical4j</groupId>
            <artifactId>ical4j</artifactId>
            <version>${ical4j.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <dependency>
            <groupId>com.afrotransact</groupId>
            <artifactId>platform-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock-standalone</artifactId>
            <version>${wiremock.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <!-- Release 1 (ADR 0011): a copy of the service's config and migrations under modules/seller/, so that several modules in one
             JVM do not share one application.yml or one db/migration. The plain jar carries only these copies. -->
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <targetPath>modules/seller</targetPath>
                <includes>
                    <include>application*.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources/db/migration</directory>
                <targetPath>modules/seller/db/migration</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>plain-jar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <configuration>
                            <classifier>plain</classifier>
                            <excludes>
                                <exclude>application*.yml</exclude>
                                <exclude>logback-spring.xml</exclude>
                                <exclude>db/migration/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>com.google.cloud.tools</groupId>
                <artifactId>jib-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
