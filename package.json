{
  "name": "diaspora-commerce",
  "private": true,
  "description": "AfroTransact v2 JavaScript workspace (web apps, shared packages, mobile apps, developer portal)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "build": "pnpm -r build",
    "web:dev": "pnpm --filter storefront dev",
    "web:e2e": "pnpm --filter storefront e2e",
    "generate:clients": "pnpm --filter @afrotransact/api-client generate",
    "docs:dev": "pnpm --filter @afrotransact/docs-portal start",
    "docs:build": "pnpm --filter @afrotransact/docs-portal build",
    "contracts:lint": "tools/contracts/lint_contracts.sh",
    "contracts:clients": "tools/contracts/generate_clients.sh",
    "contracts:clients:check": "tools/contracts/generate_clients.sh --check",
    "e2e": "pnpm --filter @afrotransact/e2e test",
    "e2e:a11y": "pnpm --filter @afrotransact/e2e test:a11y",
    "mobile:customer": "pnpm --filter @afrotransact/customer-app start:mock",
    "mobile:driver": "pnpm --filter @afrotransact/driver-app start:mock",
    "mobile:check": "pnpm --filter './mobile/apps/*' --parallel run typecheck && pnpm --filter './mobile/apps/*' run lint && pnpm --filter './mobile/apps/*' run test"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@next/eslint-plugin-next": "16.4.3",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "eslint-plugin-storybook": "10.6.1",
    "globals": "^17.13.0",
    "openapi-typescript": "^7.13.0",
    "stylelint": "^17.16.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.71.1"
  },
  "pnpm": {
    "overrides": {
      "tinypool@<2.2.0": "2.2.0",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "serialize-javascript@<7.0.5": "7.1.2",
      "storybook@>=10.0.0 <10.6.2": "10.6.2",
      "@storybook/addon-vitest@>=10.0.0 <10.6.2": "10.6.2",
      "dompurify@<=3.4.16": "3.4.17",
      "zod@<4.6.6": "4.6.6",
      "body-parser@<1.20.9": "1.20.9",
      "body-parser@>=2.0.0 <2.4.0": "2.4.0",
      "undici@>=6.0.0 <6.29.1": "6.29.1",
      "undici@>=7.0.0 <7.30.1": "7.30.1",
      "fast-uri@>=3.0.0 <3.1.9": "3.1.9",
      "serialize-javascript@<7.1.3": "7.1.3",
      "@vitest/browser@>=5.0.0-beta.6 <5.0.5": "5.0.5",
      "@vitest/ui@>=5.0.0-beta.6 <5.0.5": "5.0.5",
      "decode-uri-component@<=0.4.2": "0.5.0",
      "postcss-selector-parser@<7.1.6": "7.1.6",
      "uuid@<11.1.1": "11.1.1",
      "vitest@<5.0.5": "5.0.5",
      "@vitest/coverage-v8@<5.0.5": "5.0.5",
      "@vitest/browser-playwright@<5.0.5": "5.0.5"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-86w9-cpqp-85rv"
      ]
    }
  }
}
