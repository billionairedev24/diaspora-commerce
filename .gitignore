# Java
target/
*.class
.mvn/wrapper/maven-wrapper.jar
# Go
/go/**/bin/
# `go build` inside a service directory drops the binary next to the sources
/go/services/*/gateway-bff
*.test
coverage.out
# Node
node_modules/
.next/
.open-next/
.turbo/
dist/
build/
storybook-static/
.expo/
.wrangler/
# Terraform
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
# Env & secrets
.env
.env.*
!.env.example
# Local provider credentials (template: infra/local/secrets.env.example; .local/ is ignored below too)
secrets.env
*.pem
# IDE / OS
.idea/
.vscode/*
!.vscode/extensions.json
*.iml
.DS_Store
# Helm dependency builds
**/deploy/helm/charts/
**/deploy/helm/Chart.lock
__pycache__/
*.pyc
*.tsbuildinfo
.next-e2e/
.next-prod/
# Any other Next.js build folder (NEXT_DIST_DIR=.next-<purpose>: repro, resp, …)
.next-*/
.local/
# Written by next dev (Next.js 16 agent notes)
web/apps/*/AGENTS.md
# Generated by next dev / build / typegen (typecheck runs next typegen first)
web/apps/*/next-env.d.ts

# Optional welcome photos / videos for the Expo apps (tools/seed/mobile_hero.py; docs/engineering/mobile-on-your-phone.md)
mobile/apps/*/assets/hero/
.junie/
*.whl
infra/ovh-vps/config.env
infra/ovh-vps/secrets.local.env
.ovh/
