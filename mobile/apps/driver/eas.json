{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "10.28.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "ios": { "simulator": true },
      "env": { "EXPO_PUBLIC_APP_ENV": "dev", "EXPO_PUBLIC_MOCKS": "0" }
    },
    "development-mocks": {
      "extends": "development",
      "env": { "EXPO_PUBLIC_APP_ENV": "local", "EXPO_PUBLIC_MOCKS": "1" }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": { "EXPO_PUBLIC_APP_ENV": "uat", "EXPO_PUBLIC_MOCKS": "0" }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": { "EXPO_PUBLIC_APP_ENV": "prod", "EXPO_PUBLIC_MOCKS": "0" }
    }
  },
  "submit": {
    "production": {
      "ios": { "ascAppId": "REPLACE_WITH_DRIVER_APP_STORE_CONNECT_APP_ID" },
      "android": { "track": "internal" }
    }
  }
}
