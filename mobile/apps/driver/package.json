{
  "name": "@afrotransact/driver-app",
  "version": "2.0.0",
  "private": true,
  "description": "AfroTransact Delivery driver app (Expo / React Native, expo-router, offline-first). Epic E12, client side of S081–S087.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_APP_ENV=local EXPO_PUBLIC_MOCKS=1 expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web --port 8082",
    "export:web": "expo export --platform web --output-dir dist",
    "doctor": "expo-doctor",
    "generate": "SPECS=fulfilment,identity node scripts/generate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:generated": "SPECS=fulfilment,identity node scripts/generate.mjs --check"
  },
  "dependencies": {
    "@afrotransact/i18n": "workspace:*",
    "@afrotransact/telemetry": "workspace:*",
    "@afrotransact/tokens": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@sentry/react-native": "8.27.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-network": "~57.0.2",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-view-shot": "5.1.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
