{
  "name": "@afrotransact/customer-app",
  "version": "2.0.0",
  "private": true,
  "description": "AfroTransact customer app (Expo / React Native, expo-router). Epic E26, stories S163\u2013S168.",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:mock": "EXPO_PUBLIC_APP_ENV=local EXPO_PUBLIC_MOCKS=1 expo start",
    "smoke": "node scripts/smoke.mjs",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "export:web": "expo export --platform web --output-dir dist",
    "doctor": "expo-doctor",
    "brand": "node ../../scripts/brand-assets.mjs customer",
    "check:brand": "node ../../scripts/brand-assets.mjs customer --check",
    "generate": "SPECS=bookings,identity node scripts/generate.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:generated": "SPECS=bookings,identity node scripts/generate.mjs --check"
  },
  "dependencies": {
    "@afrotransact/api-client": "workspace:*",
    "@afrotransact/i18n": "workspace:*",
    "@afrotransact/telemetry": "workspace:*",
    "@afrotransact/tokens": "workspace:*",
    "@expo/metro-runtime": "~57.0.16",
    "@sentry/react-native": "8.27.0",
    "@stripe/stripe-react-native": "0.64.0",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-auth-session": "~57.0.14",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "phosphor-react-native": "^3.0.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-webview": "13.16.1",
    "react-native-worklets": "0.10.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/react": "~19.2.18",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "sharp": "0.35.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  },
  "expo": {
    "install": {
      "exclude": [
        "@sentry/react-native"
      ]
    }
  }
}
