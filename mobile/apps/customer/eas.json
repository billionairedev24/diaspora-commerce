{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "node": "22.12.0",
      "pnpm": "10.28.0"
    },
    "development": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "dev",
        "EXPO_PUBLIC_MOCKS": "0",
        "EXPO_PUBLIC_WEB_URL": "https://dev.afrotransact.com",
        "EXPO_PUBLIC_BFF_URL": "https://api.dev.afrotransact.com/bff",
        "EXPO_PUBLIC_OIDC_ISSUER": "https://auth.dev.afrotransact.com",
        "EXPO_PUBLIC_IDENTITY_URL": "https://api.dev.afrotransact.com/identity",
        "EXPO_PUBLIC_BOOKINGS_URL": "https://api.dev.afrotransact.com/bookings"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "development-mocks": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "local",
        "EXPO_PUBLIC_MOCKS": "1"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "extends": "base",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_APP_ENV": "uat",
        "EXPO_PUBLIC_MOCKS": "0",
        "EXPO_PUBLIC_WEB_URL": "https://uat.afrotransact.com",
        "EXPO_PUBLIC_BFF_URL": "https://api.uat.afrotransact.com/bff",
        "EXPO_PUBLIC_OIDC_ISSUER": "https://auth.uat.afrotransact.com",
        "EXPO_PUBLIC_IDENTITY_URL": "https://api.uat.afrotransact.com/identity",
        "EXPO_PUBLIC_BOOKINGS_URL": "https://api.uat.afrotransact.com/bookings"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "extends": "base",
      "channel": "production",
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_APP_ENV": "prod",
        "EXPO_PUBLIC_MOCKS": "0",
        "EXPO_PUBLIC_WEB_URL": "https://afrotransact.com",
        "EXPO_PUBLIC_BFF_URL": "https://api.afrotransact.com/bff",
        "EXPO_PUBLIC_OIDC_ISSUER": "https://auth.afrotransact.com",
        "EXPO_PUBLIC_IDENTITY_URL": "https://api.afrotransact.com/identity",
        "EXPO_PUBLIC_BOOKINGS_URL": "https://api.afrotransact.com/bookings"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "REPLACE_WITH_APP_STORE_CONNECT_APP_ID"
      },
      "android": {
        "track": "internal"
      }
    }
  }
}
