{
  "extends": [
    "expo/tsconfig.base",
    "../../../tsconfig.base.json"
  ],
  "compilerOptions": {
    "module": "preserve",
    "moduleResolution": "bundler",
    "customConditions": [
      "react-native"
    ],
    "lib": [
      "DOM",
      "ESNext"
    ],
    "target": "ESNext",
    "allowJs": false,
    "types": [],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "*.config.mts",
    "app.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "android",
    "ios"
  ]
}
