{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "plugins": [{ "name": "next" }],
    "types": ["node", "@testing-library/jest-dom"],
    "paths": { "@/*": ["./src/*"] },
    "allowJs": true,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/tsconfig.tsbuildinfo"
  },
  "include": ["src", "test", "*.ts"],
  "exclude": ["node_modules", ".next", ".next-e2e", ".next-prod", ".next-*", "next-env.d.ts"]
}
