{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker per environment, named like the Workers routes in infra/cloudflare (seller-center-<env>); routes are owned
  // by infra/cloudflare. The top level is dev; `wrangler deploy --env uat|prod` selects the others. Every var is
  // read on the server per request, so one build serves every environment. Hosts: docs/engineering/environments.md.
  "name": "seller-center-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {"CSP_MODE": "report-only", "MEDIA_PUBLIC_URL": "https://media.dev.afrotransact.com", "BFF_ORIGIN": "https://api.dev.afrotransact.com/bff", "PUBLIC_WEB_URL": "https://www.dev.afrotransact.com"},
  "env": {
    // PR previews: a version of seller-center-dev on the in-process mock BFF.
    "preview": {
      "name": "seller-center-dev",
      "vars": { "CSP_MODE": "report-only", "MEDIA_PUBLIC_URL": "https://media.dev.afrotransact.com", "API_MOCKS": "1", "BFF_ORIGIN": "", "PUBLIC_WEB_URL": "https://www.dev.afrotransact.com" }
    },
    "uat": { "name": "seller-center-uat", "vars": {"CSP_MODE": "report-only", "MEDIA_PUBLIC_URL": "https://media.uat.afrotransact.com", "BFF_ORIGIN": "https://api.uat.afrotransact.com/bff", "PUBLIC_WEB_URL": "https://www.uat.afrotransact.com"} },
    "prod": { "name": "seller-center-prod", "vars": {"CSP_MODE": "report-only", "MEDIA_PUBLIC_URL": "https://media.afrotransact.com", "BFF_ORIGIN": "https://api.afrotransact.com/bff", "PUBLIC_WEB_URL": "https://www.afrotransact.com"} }
  }
}
