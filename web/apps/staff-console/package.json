{
  "name": "staff-console",
  "version": "0.1.0",
  "private": true,
  "description": "AfroTransact staff console (Next.js 16 App Router) \u2014 the platform back office, gated by RBAC.",
  "type": "module",
  "scripts": {
    "dev": "next dev --port 3002",
    "dev:mocks": "NEXT_PUBLIC_API_MOCKS=1 next dev --port 3002",
    "build": "next build",
    "start": "next start --port 3002",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview"
  },
  "dependencies": {
    "@afrotransact/account": "workspace:*",
    "@afrotransact/api-client": "workspace:*",
    "@afrotransact/data-table": "workspace:*",
    "@afrotransact/i18n": "workspace:*",
    "@afrotransact/telemetry": "workspace:*",
    "@afrotransact/tokens": "workspace:*",
    "@afrotransact/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "8.21.3",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.5",
    "@opennextjs/cloudflare": "^1.20.10"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3",
    "wrangler": "^4.149.0"
  }
}
