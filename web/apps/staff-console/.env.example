# Local runtime settings (copy to .env.local). Deployed values come from the Worker's vars per environment
# (docs/engineering/environments.md); all of them are read on the server per request, not inlined at build time.
# Run the staff console against the in-process MSW mock BFF (no backend needed). Runtime flag.
NEXT_PUBLIC_API_MOCKS=1
# Gateway BFF origin used by the /api/bff proxy and server components when mocks are off.
BFF_ORIGIN=http://localhost:8200
# Storefront origin (sign-in, public pages); the shared PUBLIC_WEB_URL.
PUBLIC_WEB_URL=http://localhost:3000
