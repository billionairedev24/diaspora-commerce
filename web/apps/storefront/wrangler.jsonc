{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker per environment, named like the Workers routes in infra/cloudflare (storefront-<env>). The top level
  // is dev; `wrangler deploy --env uat|prod` selects the others. Every var is read on the server per request
  // (src/lib/config.ts), so one build serves every environment. Hosts: docs/engineering/environments.md.
  "name": "storefront-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  // The storefront is the base host of its environment (afrotransact.com in prod, <suffix>.afrotransact.com elsewhere: infra/cloudflare/hosts.json,
  // no www). APP_ENV is what the SEO policy reads (src/lib/seo/policy.ts): ONLY "prod" on ITS OWN host is indexable; every other
  // value, a missing value, and any other host (workers.dev, previews) is noindex. test/seo-env-safety.test.ts checks this file against the host map.
  "routes": [{ "pattern": "dev.afrotransact.com/*", "zone_name": "afrotransact.com" }],
  "vars": {
    "APP_ENV": "dev", "CSP_MODE": "report-only", "MEDIA_PUBLIC_URL": "https://media-dev.afrotransact.com",
    "PUBLIC_WEB_URL": "https://dev.afrotransact.com",
    "BFF_ORIGIN": "https://api-dev.afrotransact.com/bff",
    "SELLER_CENTER_URL": "https://seller-dev.afrotransact.com",
    "STAFF_CONSOLE_URL": "https://admin-dev.afrotransact.com",
    "API_MOCKS": "0"
  },
  "env": {
    // PR previews: a version of storefront-dev on the in-process mock BFF.
    "preview": {
      "name": "storefront-dev",
      "vars": { "APP_ENV": "preview", "CSP_MODE": "report-only", "MEDIA_PUBLIC_URL": "https://media-dev.afrotransact.com", "API_MOCKS": "1", "PUBLIC_WEB_URL": "https://dev.afrotransact.com", "BFF_ORIGIN": "", "SELLER_CENTER_URL": "https://seller-dev.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin-dev.afrotransact.com" }
    },
    "uat": {
      "name": "storefront-uat",
      "routes": [{ "pattern": "uat.afrotransact.com/*", "zone_name": "afrotransact.com" }],
      "vars": { "APP_ENV": "uat", "CSP_MODE": "enforce", "MEDIA_PUBLIC_URL": "https://media-uat.afrotransact.com", "API_MOCKS": "0", "PUBLIC_WEB_URL": "https://uat.afrotransact.com", "BFF_ORIGIN": "https://api-uat.afrotransact.com/bff", "SELLER_CENTER_URL": "https://seller-uat.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin-uat.afrotransact.com" }
    },
    "prod": {
      "name": "storefront-prod",
      // Prod: afrotransact.com, the one canonical host (no www in the host map). The only environment that may be indexed.
      "routes": [{ "pattern": "afrotransact.com/*", "zone_name": "afrotransact.com" }],
      "vars": { "APP_ENV": "prod", "CSP_MODE": "enforce", "MEDIA_PUBLIC_URL": "https://media.afrotransact.com", "API_MOCKS": "0", "PUBLIC_WEB_URL": "https://afrotransact.com", "BFF_ORIGIN": "https://api.afrotransact.com/bff", "SELLER_CENTER_URL": "https://seller.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin.afrotransact.com" }
    },
    // trial: the 8-day OVH run (prod profile, flat single-label hosts under the zone, docs/runbooks/ovh-production.md "Trial").
    // The hosts below are the default zone; the trial workflow writes the same shape for the zone you give it. Routes: infra/cloudflare.
    "trial": {
      "name": "storefront-trial",
      "routes": [{ "pattern": "test.afrotransact.com/*", "zone_name": "afrotransact.com" }],
      "vars": { "APP_ENV": "trial", "CSP_MODE": "enforce", "MEDIA_PUBLIC_URL": "https://media-test.afrotransact.com", "API_MOCKS": "0", "PUBLIC_WEB_URL": "https://test.afrotransact.com", "BFF_ORIGIN": "https://api-test.afrotransact.com/bff", "SELLER_CENTER_URL": "https://seller-test.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin-test.afrotransact.com" }
    }
  }
}
