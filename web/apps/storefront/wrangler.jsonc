{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "afrotransact-storefront",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "BFF_ORIGIN": "https://api.dev.afrotransact.com/bff",
    "NEXT_PUBLIC_SELLER_CENTER_URL": "https://sell.dev.afrotransact.com",
    "API_MOCKS": "0"
  },
  "env": {
    "preview": {
      "name": "afrotransact-storefront-preview",
      "vars": { "API_MOCKS": "1", "BFF_ORIGIN": "", "NEXT_PUBLIC_SELLER_CENTER_URL": "https://sell.dev.afrotransact.com" }
    },
    "uat": {
      "name": "afrotransact-storefront-uat",
      "vars": { "API_MOCKS": "0", "BFF_ORIGIN": "https://api.uat.afrotransact.com/bff", "NEXT_PUBLIC_SELLER_CENTER_URL": "https://sell.uat.afrotransact.com" }
    },
    "prod": {
      "name": "afrotransact-storefront",
      "routes": [{ "pattern": "www.afrotransact.com", "custom_domain": true }],
      "vars": { "API_MOCKS": "0", "BFF_ORIGIN": "https://api.afrotransact.com/bff", "NEXT_PUBLIC_SELLER_CENTER_URL": "https://sell.afrotransact.com" }
    }
  }
}
