{
  "$schema": "node_modules/wrangler/config-schema.json",
  // One Worker per environment, named like the Workers routes in infra/cloudflare (storefront-<env>). The top level
  // is dev; `wrangler deploy --env uat|prod` selects the others. Every var is read on the server per request
  // (src/lib/config.ts), so one build serves every environment. Hosts: docs/engineering/environments.md.
  "name": "storefront-dev",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "observability": { "enabled": true },
  "vars": {
    "PUBLIC_WEB_URL": "https://dev.afrotransact.com",
    "BFF_ORIGIN": "https://api.dev.afrotransact.com/bff",
    "SELLER_CENTER_URL": "https://seller.dev.afrotransact.com",
    "STAFF_CONSOLE_URL": "https://admin.dev.afrotransact.com",
    "API_MOCKS": "0"
  },
  "env": {
    // PR previews: a version of storefront-dev on the in-process mock BFF.
    "preview": {
      "name": "storefront-dev",
      "vars": { "API_MOCKS": "1", "PUBLIC_WEB_URL": "https://dev.afrotransact.com", "BFF_ORIGIN": "", "SELLER_CENTER_URL": "https://seller.dev.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin.dev.afrotransact.com" }
    },
    "uat": {
      "name": "storefront-uat",
      "vars": { "API_MOCKS": "0", "PUBLIC_WEB_URL": "https://uat.afrotransact.com", "BFF_ORIGIN": "https://api.uat.afrotransact.com/bff", "SELLER_CENTER_URL": "https://seller.uat.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin.uat.afrotransact.com" }
    },
    "prod": {
      "name": "storefront-prod",
      // The prod storefront is www.afrotransact.com (same zone route as infra/cloudflare, storefront_host = "www").
      // The apex has no route here: it is 301-redirected to www at the edge (Cloudflare redirect rule), path and query kept.
      "routes": [{ "pattern": "www.afrotransact.com/*", "zone_name": "afrotransact.com" }],
      "vars": { "API_MOCKS": "0", "PUBLIC_WEB_URL": "https://www.afrotransact.com", "BFF_ORIGIN": "https://api.afrotransact.com/bff", "SELLER_CENTER_URL": "https://seller.afrotransact.com", "STAFF_CONSOLE_URL": "https://admin.afrotransact.com" }
    }
  }
}
