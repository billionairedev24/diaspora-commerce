# Local runtime settings (copy to .env.local). Deployed values come from wrangler.jsonc vars per environment
# (docs/engineering/environments.md); all of them are read on the server per request, not inlined at build time.
# Run the storefront against the in-process MSW mock BFF (no backend needed). Runtime flag.
NEXT_PUBLIC_API_MOCKS=1
# Gateway BFF origin used by the /api/bff proxy and server components when mocks are off.
BFF_ORIGIN=http://localhost:8200
# Seller Center & Provider Hub (Sell on AfroTransact / Offer your services); the shared SELLER_CENTER_URL.
SELLER_CENTER_URL=http://localhost:3001
# Staff console (account menu link for staff); the shared STAFF_CONSOLE_URL.
STAFF_CONSOLE_URL=http://localhost:3002
