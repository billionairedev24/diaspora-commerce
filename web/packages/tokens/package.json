{
  "name": "@afrotransact/tokens",
  "version": "0.1.0",
  "private": true,
  "description": "AfroTransact design tokens: CSS custom properties (--at-*) plus a generated typed object for React Native.",
  "type": "module",
  "sideEffects": ["*.css"],
  "exports": {
    ".": "./src/index.ts",
    "./native": "./src/native.ts",
    "./tokens.css": "./src/tokens.css",
    "./fonts.css": "./src/fonts.css"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource/figtree": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
