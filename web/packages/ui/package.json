{
  "name": "@afrotransact/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared, accessible React components for the AfroTransact storefront, Seller Center and staff console.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./global.css": "./src/global.css",
    "./assets/*": "./assets/*"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "test-storybook --index-json --url ${STORYBOOK_URL:-http://127.0.0.1:6007}",
    "test-storybook:static": "rm -rf test-results && node scripts/serve-static.mjs -- test-storybook --index-json --url http://127.0.0.1:6007 --maxWorkers=2",
    "visual": "playwright test -c visual/playwright.config.ts",
    "visual:update": "playwright test -c visual/playwright.config.ts --update-snapshots=all",
    "visual:docker": "scripts/visual-docker.sh",
    "visual:update:docker": "scripts/visual-docker.sh --update-snapshots=all",
    "build": "storybook build --quiet"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-tabs": "^1.1.22",
    "libphonenumber-js": "^1.13.15",
    "simple-icons": "9.21.0"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@afrotransact/tokens": "workspace:*",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@storybook/addon-a11y": "10.6.1",
    "@storybook/addon-docs": "10.6.1",
    "@storybook/react-vite": "10.6.1",
    "@storybook/test-runner": "0.26.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
