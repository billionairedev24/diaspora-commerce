{
  "name": "@afrotransact/account",
  "version": "0.1.0",
  "private": true,
  "description": "Account settings screens shared by the storefront, Seller Center and staff console: sign-in & security (authenticator QR enrolment, SMS, recovery codes, passkeys, trusted browsers, sessions, activity), profile, notifications and preferences.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@afrotransact/api-client": "workspace:*",
    "@afrotransact/data-table": "workspace:*",
    "@afrotransact/i18n": "workspace:*",
    "@afrotransact/ui": "workspace:*",
    "@phosphor-icons/react": "^2.1.10"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.104.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "jsqr": "1.4.0",
    "msw": "^2.15.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "^8.3.4",
    "vitest": "5.0.3"
  }
}
