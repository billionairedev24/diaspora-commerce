{
  "name": "@afrotransact/tour",
  "version": "0.1.0",
  "private": true,
  "description": "Guided tours for the back offices: typed tour definitions (Zod), a TourService, per-user progress, a React provider and hooks, token-based styling. The tour engine (Driver.js, MIT) sits behind our own TourEngine interface so it can be swapped.",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./react": "./src/react.tsx",
    "./testing": "./src/testing.ts",
    "./tour.css": "./src/tour.css"
  },
  "scripts": {
    "lint": "eslint . && stylelint \"src/**/*.css\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@afrotransact/ui": "workspace:*",
    "driver.js": "1.12.1",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^27.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
